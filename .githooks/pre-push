#!/bin/sh
set -eu
trade_node="$(command -v node || true)"
if [ -z "$trade_node" ]; then trade_node="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"; fi
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_ref" in refs/heads/main|refs/heads/master)
    if [ "${TRADEASSIST_INITIAL_PUSH:-}" != "1" ]; then
      echo 'Push a codex/ branch and open a pull request; direct main pushes are disabled.' >&2
      exit 1
    fi ;;
  esac
  "$trade_node" scripts/repository-privacy-check.mjs --history "$local_sha"
done
