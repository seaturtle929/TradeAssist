# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Credentials and environment files; never commit
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# TypeScript incremental compilation cache
*.tsbuildinfo
.Start Trade Assist.command.swp

# Local records, deployment bindings, editor artifacts and private QA.
/.openai/
*.swp
*.swo
*.log
*.sqlite*
*.db
*.wav
*.mp3
*.m4a
*.webm
*.har
*.private.*
/app/regression/
/components/regression-harness.*
/lib/brain-regressions.ts
/lib/debug-scenarios.ts
/lib/private-learning-fixtures.ts

# Keep existing private QA on this Mac. Publish reviewed runtime tools only.
/scripts/*
!/scripts/build-verified.sh
!/scripts/execution-profile.mjs
!/scripts/install-ci.mjs
!/scripts/install-ci.sh
!/scripts/install-pnpm.sh
!/scripts/npm-install.mjs
!/scripts/pnpm-install.mjs
!/scripts/run-framework.mjs
!/scripts/sites-env.mjs
!/scripts/sites-env.sh
!/scripts/start-local.mjs
!/scripts/stop-local.mjs
!/scripts/repository-privacy-check.mjs
!/scripts/connector-preview/

# Reviewed, deliberately synthetic offline conversation suite. Private evidence
# and historical QA runners above remain excluded.
!/scripts/conversation-regression-suite.mjs
!/scripts/regression/
/scripts/regression/*
!/scripts/regression/typescript-loader.mjs
!/scripts/regression/conversation-worker.mjs
!/scripts/regression/conversation-fixtures.mjs
!/scripts/regression/evaluate-reply.mjs
